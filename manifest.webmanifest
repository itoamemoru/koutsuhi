{
  "name": "交通費申請（自家用車使用距離申請書）",
  "short_name": "交通費申請",
  "description": "タイムラインのJSONから自家用車使用距離申請書を作る入力サポート",
  "lang": "ja",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F2EEEA",
  "theme_color": "#35402F",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "file", "accept": ["application/json", "text/plain", "application/octet-stream", ".json"] }
      ]
    }
  }
}
